{
  "swagger": "2.0",
  "info": {
    "title": "OCR AI API",
    "description": "API for submitting documents for OCR and data extraction.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/extract": {
      "post": {
        "summary": "Submit documents for extraction",
        "consumes": ["multipart/form-data"],
        "parameters": [
          {
            "name": "doc_type",
            "in": "formData",
            "type": "string",
            "description": "A hint for the document type (e.g., 'Passport'). Optional."
          },
          {
            "name": "files",
            "in": "formData",
            "type": "file",
            "required": true,
            "description": "One or more files (images or PDFs) to process."
          }
        ],
        "responses": {
          "202": {
            "description": "Processing started successfully.",
            "schema": {
              "type": "object",
              "properties": {
                "task_id": {"type": "string"},
                "status_url": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "/status/{task_id}": {
      "get": {
        "summary": "Check the status of a processing task",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "type": "string",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Current status of the task."
          }
        }
      }
    }
  }
}